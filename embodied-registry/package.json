{
  "name": "knownrobot-web",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsc -p tests/tsconfig.json && node --test tests/registry.test.cjs tests/sprint.test.cjs tests/distribution.test.cjs",
    "adapters:verify": "tsc -p tests/tsconfig.json && node scripts/adapter-ownership.cjs",
    "sprint:check": "tsc -p tests/tsconfig.json && node scripts/sprint-operations.cjs check",
    "sprint:verify": "tsc -p tests/tsconfig.json && node scripts/sprint-operations.cjs verify",
    "sprint:operate": "tsc -p tests/tsconfig.json && node scripts/sprint-operations.cjs operate",
    "test:smoke": "node tests/production-smoke.cjs",
    "test:preview": "node tests/preview-smoke.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
