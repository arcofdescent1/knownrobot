NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random bytes, server-only. Grants access only to the aggregate
# marketing metrics route; never expose it with a NEXT_PUBLIC_ prefix.
KNOWNROBOT_REPORTING_TOKEN=

# Leave unset for live public reads. Set demo only for explicit fictional previews.
KNOWNROBOT_REGISTRY_MODE=

# Enable only after verified custom SMTP is configured in Supabase Auth.
# This server-only flag enables KnownRobot-native email-code sign-in.
KNOWNROBOT_EMAIL_AUTH_READY=false
